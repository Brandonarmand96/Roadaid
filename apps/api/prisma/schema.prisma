datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ServiceType {
  FUEL
  TOWING
  LOCKOUT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProviderAvailability {
  OFFLINE
  ONLINE
  RESERVED
  BUSY
  UNAVAILABLE
}

enum RequestStatus {
  REQUESTED
  SEARCHING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ESCALATED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CancelledBy {
  CUSTOMER
  PROVIDER
  ADMIN
  SYSTEM
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum LedgerEntryType {
  CUSTOMER_PAYMENT
  PROVIDER_EARNING
  PLATFORM_COMMISSION
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum VehicleType {
  CAR
  SUV
  VAN
  TRUCK
  MOTORCYCLE
}

enum DocumentType {
  NATIONAL_ID
  DRIVERS_LICENCE
  VEHICLE_PAPERS
  EQUIPMENT_PHOTO
  PROFILE_PHOTO
  OTHER
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  role         Role       @default(CUSTOMER)
  phone        String     @unique @db.VarChar(20)
  email        String?    @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(255)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(1024)
  status       UserStatus @default(ACTIVE)
  adminRole    AdminRole? @map("admin_role")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  customerVehicles CustomerVehicle[]
  providerProfile  ProviderProfile?
  serviceRequests  ServiceRequest[]  @relation("CustomerRequests")
  assignedRequests ServiceRequest[]  @relation("ProviderAssignedRequests")
  notifications    Notification[]
  supportCases     SupportCase[]
  auditLogs        AuditLog[]        @relation("ActorAuditLogs")

  @@map("users")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  purpose    String    @default("LOGIN") @db.VarChar(50)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([phone, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String   @db.VarChar(20) // ANDROID | IOS
  token      String   @unique @db.VarChar(512)
  app        String   @db.VarChar(20) // CUSTOMER | PROVIDER
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model CustomerVehicle {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  make        String      @db.VarChar(100)
  model       String      @db.VarChar(100)
  color       String      @db.VarChar(50)
  plateNumber String      @map("plate_number") @db.VarChar(30)
  vehicleType VehicleType @default(CAR) @map("vehicle_type")
  isDefault   Boolean     @default(false) @map("is_default")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_vehicles")
}

model ProviderProfile {
  userId           String               @id @map("user_id") @db.Uuid
  businessName     String?              @map("business_name") @db.VarChar(255)
  address          String?              @db.VarChar(500)
  availability     ProviderAvailability @default(OFFLINE)
  currentRequestId String?              @map("current_request_id") @db.Uuid
  ratingAvg        Decimal              @default(5.0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int                  @default(0) @map("rating_count")
  completedJobs    Int                  @default(0) @map("completed_jobs")
  vehicleMake      String?              @map("vehicle_make") @db.VarChar(100)
  vehicleModel     String?              @map("vehicle_model") @db.VarChar(100)
  vehiclePlate     String?              @map("vehicle_plate") @db.VarChar(30)
  equipmentNotes   String?              @map("equipment_notes") @db.Text
  onboardingStatus OnboardingStatus     @default(DRAFT) @map("onboarding_status")
  reviewedBy       String?              @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz
  rejectionReason  String?              @map("rejection_reason") @db.Text
  walletBalanceKobo BigInt              @default(0) @map("wallet_balance_kobo")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services         ProviderService[]
  documents        ProviderDocument[]
  location         ProviderLocation?
  bankAccounts     ProviderBankAccount[]
  payoutRequests   PayoutRequest[]
  offers           DispatchOffer[]

  @@map("provider_profiles")
}

model ProviderService {
  id              String         @id @default(uuid()) @db.Uuid
  providerId      String         @map("provider_id") @db.Uuid
  serviceType     ServiceType    @map("service_type")
  status          ApprovalStatus @default(PENDING)
  details         Json?          @db.JsonB
  approvedBy      String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz
  rejectionReason String?        @map("rejection_reason") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@unique([providerId, serviceType])
  @@map("provider_services")
}

model ProviderDocument {
  id          String         @id @default(uuid()) @db.Uuid
  providerId  String         @map("provider_id") @db.Uuid
  serviceType ServiceType?   @map("service_type")
  docType     DocumentType   @map("doc_type")
  storageKey  String         @map("storage_key") @db.VarChar(512)
  mimeType    String         @map("mime_type") @db.VarChar(100)
  sizeBytes   Int            @map("size_bytes")
  status      ApprovalStatus @default(PENDING)
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  note        String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_documents")
}

model ProviderLocation {
  providerId String   @id @map("provider_id") @db.Uuid
  heading    Float?
  speedMps   Float?   @map("speed_mps")
  accuracyM  Float    @map("accuracy_m")
  recordedAt DateTime @map("recorded_at") @db.Timestamptz
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@map("provider_locations")
}

model ProviderLocationHistory {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  requestId  String?  @map("request_id") @db.Uuid
  accuracyM  Float    @map("accuracy_m")
  recordedAt DateTime @map("recorded_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([providerId, recordedAt])
  @@map("provider_location_history")
}

model PricingRule {
  id           String      @id @default(uuid()) @db.Uuid
  serviceType  ServiceType @unique @map("service_type")
  baseKobo     BigInt      @map("base_kobo")
  perKmKobo    BigInt      @default(0) @map("per_km_kobo")
  perLitreKobo BigInt      @default(0) @map("per_litre_kobo")
  minKobo      BigInt      @map("min_kobo")
  towingFreeKm Float       @default(0) @map("towing_free_km")
  active       Boolean     @default(true)
  updatedBy    String?     @map("updated_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@map("pricing_rules")
}

model DispatchSettings {
  id                      String      @id @default(uuid()) @db.Uuid
  serviceType             ServiceType @unique @map("service_type")
  offerTimeoutSeconds     Int         @default(30) @map("offer_timeout_seconds")
  searchRadiusKm          Float       @default(15) @map("search_radius_km")
  maxOffers               Int         @default(5) @map("max_offers")
  candidateShortlistSize  Int         @default(5) @map("candidate_shortlist_size")
  staleLocationSeconds    Int         @default(90) @map("stale_location_seconds")
  maxSearchDurationSeconds Int        @default(600) @map("max_search_duration_seconds")
  updatedBy               String?     @map("updated_by") @db.Uuid
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@map("dispatch_settings")
}

model CommissionSettings {
  id            String      @id @default(uuid()) @db.Uuid
  serviceType   ServiceType @unique @map("service_type")
  commissionBps Int         @default(1500) @map("commission_bps") // 1500 bps = 15%
  updatedBy     String?     @map("updated_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@map("commission_settings")
}

model ServiceRequest {
  id                        String        @id @default(uuid()) @db.Uuid
  code                      String        @unique @db.VarChar(50)
  customerId                String        @map("customer_id") @db.Uuid
  serviceType               ServiceType   @map("service_type")
  status                    RequestStatus @default(REQUESTED)
  providerId                String?       @map("provider_id") @db.Uuid
  vehicleId                 String?       @map("vehicle_id") @db.Uuid
  vehicleSnapshot           Json?         @map("vehicle_snapshot") @db.JsonB
  details                   Json          @db.JsonB
  pickupAddress             String        @map("pickup_address") @db.VarChar(500)
  pickupNote                String?       @map("pickup_note") @db.Text
  distanceKm                Float?        @map("distance_km")
  priceKobo                 BigInt        @map("price_kobo")
  priceBreakdown            Json          @map("price_breakdown") @db.JsonB
  commissionBps             Int           @map("commission_bps")
  paymentStatus             PaymentStatus @default(NONE) @map("payment_status")
  paymentMode               String        @default("ONLINE_AFTER_ACCEPT") @map("payment_mode") @db.VarChar(50)
  pickupPinHash             String?       @map("pickup_pin_hash") @db.VarChar(255)
  pickupPinEncrypted        String?       @map("pickup_pin_encrypted") @db.Text
  pickupVerifiedAt          DateTime?     @map("pickup_verified_at") @db.Timestamptz
  shareToken                String?       @unique @map("share_token") @db.VarChar(100)
  beneficiaryName           String?       @map("beneficiary_name") @db.VarChar(120)
  beneficiaryPhone          String?       @map("beneficiary_phone") @db.VarChar(20)
  scheduledFor              DateTime?     @map("scheduled_for") @db.Timestamptz
  providerRatingToCustomer  Int?          @map("rating_provider_to_customer")
  providerReviewText        String?       @map("provider_review_text") @db.Text
  currentOfferId            String?       @map("current_offer_id") @db.Uuid
  offersMadeCount           Int           @default(0) @map("offers_made_count")
  dispatchRound             Int           @default(1) @map("dispatch_round")
  etaSeconds                Int?          @map("eta_seconds")
  acceptedAt                DateTime?     @map("accepted_at") @db.Timestamptz
  arrivedAt                 DateTime?     @map("arrived_at") @db.Timestamptz
  startedAt                 DateTime?     @map("started_at") @db.Timestamptz
  completedAt               DateTime?     @map("completed_at") @db.Timestamptz
  cancelledAt               DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledBy               CancelledBy?  @map("cancelled_by")
  cancelReason              String?       @map("cancel_reason") @db.Text
  cancelFeeKobo             BigInt        @default(0) @map("cancel_fee_kobo")
  searchStartedAt           DateTime      @default(now()) @map("search_started_at") @db.Timestamptz
  escalatedAt               DateTime?     @map("escalated_at") @db.Timestamptz
  ratingCustomerToProvider  Int?          @map("rating_customer_to_provider")
  reviewText                String?       @map("review_text") @db.Text
  disputeFlag               Boolean       @default(false) @map("dispute_flag")
  disputeReason             String?       @map("dispute_reason") @db.Text
  disputedAt                DateTime?     @map("disputed_at") @db.Timestamptz
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  customer User  @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Restrict)
  provider User? @relation("ProviderAssignedRequests", fields: [providerId], references: [id], onDelete: Restrict)

  events   RequestEvent[]
  offers   DispatchOffer[]
  payments Payment[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([providerId])
  @@map("service_requests")
}

model RequestEvent {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  type      String   @db.VarChar(100)
  actorType String   @map("actor_type") @db.VarChar(50) // CUSTOMER | PROVIDER | ADMIN | SYSTEM
  actorId   String?  @map("actor_id") @db.Uuid
  payload   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("request_events")
}

model DispatchOffer {
  id                 String      @id @default(uuid()) @db.Uuid
  requestId          String      @map("request_id") @db.Uuid
  providerId         String      @map("provider_id") @db.Uuid
  sequenceNo         Int         @map("sequence_no")
  status             OfferStatus @default(PENDING)
  offeredAt          DateTime    @default(now()) @map("offered_at") @db.Timestamptz
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz
  respondedAt        DateTime?   @map("responded_at") @db.Timestamptz
  distanceMAtOffer   Float?      @map("distance_m_at_offer")
  etaSecondsAtOffer  Int?        @map("eta_seconds_at_offer")
  expiryJobId        String?     @map("expiry_job_id") @db.VarChar(255)
  declineReason      String?     @map("decline_reason") @db.Text
  round              Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@unique([requestId, providerId, round])
  @@index([expiresAt])
  @@map("dispatch_offers")
}

model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  requestId       String         @map("request_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  gateway         PaymentGateway @default(PAYSTACK)
  reference       String         @unique @db.VarChar(100)
  amountKobo      BigInt         @map("amount_kobo")
  status          PaymentStatus  @default(PENDING)
  gatewayResponse Json?          @map("gateway_response") @db.JsonB
  paidAt          DateTime?      @map("paid_at") @db.Timestamptz
  idempotencyKey  String?        @map("idempotency_key") @db.VarChar(100)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([customerId])
  @@map("payments")
}

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  gateway     String   @db.VarChar(50)
  eventId     String   @map("event_id") @db.VarChar(255)
  payload     Json     @db.JsonB
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([gateway, eventId])
  @@map("webhook_events")
}

model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  type        LedgerEntryType
  requestId   String?         @map("request_id") @db.Uuid
  paymentId   String?         @map("payment_id") @db.Uuid
  providerId  String?         @map("provider_id") @db.Uuid
  amountKobo  BigInt          @map("amount_kobo") // signed
  description String          @db.VarChar(500)
  createdBy   String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([providerId])
  @@index([requestId])
  @@map("ledger_entries")
}

model PayoutRequest {
  id            String       @id @default(uuid()) @db.Uuid
  providerId    String       @map("provider_id") @db.Uuid
  amountKobo    BigInt       @map("amount_kobo")
  status        PayoutStatus @default(REQUESTED)
  bankName      String       @map("bank_name") @db.VarChar(100)
  accountNumber String       @map("account_number") @db.VarChar(20)
  accountName   String       @map("account_name") @db.VarChar(255)
  requestedAt   DateTime     @default(now()) @map("requested_at") @db.Timestamptz
  reviewedBy    String?      @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz
  paidReference String?      @map("paid_reference") @db.VarChar(255)
  note          String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@index([providerId])
  @@map("payout_requests")
}

model ProviderBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  bankName      String   @map("bank_name") @db.VarChar(100)
  accountNumber String   @map("account_number") @db.VarChar(20)
  accountName   String   @map("account_name") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  provider ProviderProfile @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@unique([providerId, accountNumber])
  @@map("provider_bank_accounts")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(255)
  body      String    @db.Text
  data      Json?     @db.JsonB
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model SupportCase {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  requestId String?  @map("request_id") @db.Uuid
  subject   String   @db.VarChar(160)
  message   String   @db.Text
  status    String   @default("OPEN") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_cases")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  ip         String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
