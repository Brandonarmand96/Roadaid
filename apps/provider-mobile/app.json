{
  "expo": {
    "name": "RoadAid Provider",
    "slug": "roadaid-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.roadaid.provider",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "RoadAid uses your location to assign nearby roadside requests while you are online.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RoadAid tracks your location in the background during active jobs to provide real-time updates and accurate ETA to the customer."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B132B"
      },
      "package": "co.roadaid.provider",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
