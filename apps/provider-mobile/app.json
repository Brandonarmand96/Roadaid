{
  "expo": {
    "name": "RoadAid",
    "slug": "roadaid",
    "version": "1.0.0",
    "icon": "./assets/roadaid-mark.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.roadaid.provider",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "RoadAid uses your location to assign nearby roadside requests while you are online.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RoadAid tracks your location in the background during active jobs to provide real-time updates and accurate ETA to the customer."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/roadaid-mark.png",
        "backgroundColor": "#191D23"
      },
      "package": "co.roadaid.provider",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "56bfab39-d430-46c9-8e6b-0ba01a26ecbc"
      }
    },
    "owner": "leroicodes"
  }
}
