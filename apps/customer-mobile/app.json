{
  "expo": {
    "name": "RoadAid Customer",
    "slug": "roadaid-customer",
    "version": "1.0.0",
    "icon": "./assets/roadaid-mark.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.roadaid.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RoadAid requires your location to send roadside assistance to your precise breakdown point."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/roadaid-mark.png",
        "backgroundColor": "#191D23"
      },
      "package": "co.roadaid.customer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
