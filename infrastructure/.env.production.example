NODE_ENV=production
PORT=3000
APP_TZ=Africa/Lagos

# Public domains and TLS registration
SITE_DOMAIN=roadaid.ng
API_DOMAIN=api.roadaid.ng
ACME_EMAIL=owner@example.com
PUBLIC_API_URL=https://api.roadaid.ng
CORS_ORIGINS=https://roadaid.ng,https://www.roadaid.ng

# Container-only data services. Generate strong, unique passwords.
POSTGRES_USER=roadaid
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=roadaid
DATABASE_URL=postgresql://roadaid:URL_ENCODED_POSTGRES_PASSWORD@postgres:5432/roadaid?schema=public
REDIS_PASSWORD=replace-with-a-different-long-random-password
REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379

# Generate each JWT value independently with at least 32 random bytes.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=RoadAid

# Google server key is IP-restricted; browser key is referrer-restricted.
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_API_URL=https://api.roadaid.ng/v1
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Start live testing with Paystack test keys.
PAYMENT_GATEWAY=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYMENT_MODE=ONLINE_AFTER_ACCEPT
CUSTOMER_ONLINE_PAYMENTS_ENABLED=false
CASH_COMMISSION_LIMIT_KOBO=5000000

# Supabase Storage or another S3-compatible service is recommended for documents.
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=provider-documents
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
ADMIN_BOOTSTRAP_EMAIL=admin@roadaid.ng
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-temporary-password
